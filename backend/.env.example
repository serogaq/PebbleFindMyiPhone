# Image used by docker-compose.yaml. Point this at GHCR or another registry for
# deployments that pull a published image.
BACKEND_IMAGE=pebble-find-my-iphone-backend
BACKEND_TAG=latest

# Apple Account that owns the target iPhone.
APPLE_ID=you@example.com

# global or china
APPLE_REGION=global

# Keep disabled unless the target is exposed through Family Sharing.
ICLOUD_WITH_FAMILY=false

# Fill this after: docker compose run --rm backend devices list
TARGET_DEVICE_ID=

# Generate with: openssl rand -hex 32
API_TOKEN=

# 127.0.0.1 exposes the API only on the server itself. For a trusted LAN,
# use 0.0.0.0 and restrict port 8080 with the server firewall.
HOST_BIND_ADDRESS=127.0.0.1
PORT=8080

# Successful commands are globally limited; identical idempotency keys replay
# the prior response without triggering a second alert.
PLAY_SOUND_COOLDOWN_SECONDS=30
IDEMPOTENCY_TTL_SECONDS=300
DEVICE_CACHE_TTL_SECONDS=60
# DEBUG includes raw upstream Apple exception tracebacks for diagnosis and can
# contain provider-supplied account details. Keep INFO in normal operation.
LOG_LEVEL=INFO

# Default timeout applied to all Apple HTTP requests.
ICLOUD_CONNECT_TIMEOUT_SECONDS=5
ICLOUD_READ_TIMEOUT_SECONDS=20
